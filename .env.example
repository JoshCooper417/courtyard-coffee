# Local SQLite database path (used when TURSO_DATABASE_URL is empty)
DB_PATH=./db/data.db

# Initial seed defaults for store_state (id = 1)
DEFAULT_ADMIN_PIN=1234
DEFAULT_BIT_PHONE=050-0000000

# Optional: Set to 1 in production to require X-Admin-Pin header on all admin write endpoints
REQUIRE_ADMIN_PIN=0

# Production Persistent Storage (Turso Serverless SQLite over HTTP v2 Pipeline)
# Example: libsql://courtyard-coffee-yourname.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
